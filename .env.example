# Copie este arquivo para .env.local e preencha os valores.
# NUNCA comite o .env.local (já está no .gitignore).

# --- Banco de dados (Neon) ---
# Pegue em neon.com → seu projeto → Connection string (Pooled, com ?sslmode=require)
DATABASE_URL="postgresql://user:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---
# Segredo para assinar as sessões. Gere um com:  npx auth secret
AUTH_SECRET="cole-um-segredo-aleatorio-aqui"

# URL do site (em produção a Vercel define sozinha; em dev pode deixar assim)
# AUTH_URL="http://localhost:3000"

# --- Login com Google (opcional) ---
# Crie em console.cloud.google.com → APIs e Serviços → Credenciais → ID do cliente OAuth
# Deixe em branco para desativar o botão "Continuar com Google".
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Mercado Pago ---
# Credenciais em mercadopago.com.br → Suas integrações → sua app → Credenciais
MP_ACCESS_TOKEN="TEST-xxxxxxxx"                 # secreto (servidor)
NEXT_PUBLIC_MP_PUBLIC_KEY="TEST-xxxxxxxx"       # público (navegador, SDK do cartão)
# Segredo do webhook (opcional): painel MP → Webhooks → "Assinatura secreta".
# Se preenchido, o webhook passa a validar a assinatura das notificações.
MP_WEBHOOK_SECRET=""

# --- Admin ---
# E-mails autorizados a acessar /admin (separados por vírgula). Use a conta GG Peitas.
ADMIN_EMAILS="contato@ggpeitas.com"

# --- Vercel Blob (fotos dos produtos) ---
# Crie o store em Vercel → Storage → Blob; o token é gerado automaticamente na Vercel.
# Para rodar/local, copie o BLOB_READ_WRITE_TOKEN do store.
BLOB_READ_WRITE_TOKEN=""

# --- E-mail automático (Resend) ---
# Crie conta em resend.com, verifique um domínio de envio e gere a API key.
# Sem a chave, os e-mails são apenas logados (não enviam) — nada quebra.
RESEND_API_KEY=""
# Remetente: precisa ser de um domínio verificado no Resend.
# Ex.: "GG Peitas <pedidos@ggpeitas.com>". Sem domínio, use onboarding@resend.dev (só p/ teste).
EMAIL_FROM="GG Peitas <onboarding@resend.dev>"
# URL pública do site (usada nos links dos e-mails; em produção a Vercel já provê VERCEL_URL)
NEXT_PUBLIC_SITE_URL="https://ggpeitas-drop.vercel.app"

# --- Cron (Vercel) ---
# Segredo opcional para proteger /api/cron/expire-orders.
# Se definido, a Vercel envia Authorization: Bearer <CRON_SECRET> automaticamente.
CRON_SECRET=""
